# Required
STOCK_API_URL=https://stock.example.com/products
STOCK_API_KEY=replace-me
RESEND_API_KEY=replace-me
RESEND_BASE_URL=https://api.resend.com
WEBHOOK_SECRET=replace-me
PORT=8000

# Optional (defaults shown)
# DATA_DIR=./data                     # /data inside the Docker image
# ADMIN_PASSWORD=                     # falls back to WEBHOOK_SECRET
# EMAIL_FROM=Back in Stock <alerts@backinstock.example>
# STORE_NAME=Back in Stock
# STORE_URL=                          # "Shop it now" button target in the email
# RECONCILE_INTERVAL_SECONDS=60
# LOG_LEVEL=INFO
